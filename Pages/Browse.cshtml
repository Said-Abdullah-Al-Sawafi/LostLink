@page
@model BrowseModel
@{ ViewData["Title"] = "Browse reports"; }

<h1 class="h3 mb-1">All reports</h1>
<p class="text-muted">Search and filter live - the table updates as you type, no page reloads.</p>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input id="searchBox" class="form-control"
               placeholder="Search text, location or status..." />
    </div>
    <div class="col-md-4">
        <select id="categoryFilter" class="form-select">
            <option value="">All categories</option>
            @foreach (ItemCategory c in Enum.GetValues<ItemCategory>())
            {
                <option value="@c">@c</option>
            }
        </select>
    </div>
</div>

<table class="table table-hover table-lostlink data-table align-middle">
    <thead>
        <tr>
            <th>Kind</th>
            <th>Report</th>
            <th>Location</th>
            <th>Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr data-category="@r.Category">
                <td>
                    <span class="badge @(r.IsLost ? "bg-danger" : "bg-lostlink")">
                        @(r.IsLost ? "Lost" : "Found")
                    </span>
                </td>
                <td>
                    <a asp-page="/Details"
                       asp-route-kind="@(r.IsLost ? "lost" : "found")"
                       asp-route-id="@r.Id">@r.Summary</a>
                </td>
                <td>@r.Location</td>
                <td>@r.Date.ToString("dd MMM yyyy")</td>
                <td><span class="badge bg-secondary">@r.Status</span></td>
            </tr>
        }
    </tbody>
</table>
