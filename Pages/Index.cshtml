@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 rounded-3 bg-lostlink text-white">
    <h1 class="display-5 fw-bold">LostLink</h1>
    <p class="lead mb-0">
        A smart lost &amp; found matching and verification platform. Structured reports,
        an explainable 0-100 matching engine, and verified handovers - so the right item
        reaches the right owner.
    </p>
</div>

<div class="row text-center g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="display-6 fw-bold stat-count" data-count="@Model.LostCount">@Model.LostCount</div>
                <div class="text-muted">items reported lost</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="display-6 fw-bold stat-count" data-count="@Model.FoundCount">@Model.FoundCount</div>
                <div class="text-muted">items waiting to be claimed</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="display-6 fw-bold stat-count" data-count="@Model.ReunitedCount">@Model.ReunitedCount</div>
                <div class="text-muted">owners reunited</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-lostlink text-white fw-bold">Latest lost reports</div>
            <ul class="list-group list-group-flush">
                @foreach (var item in Model.LatestLost)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span>@item.Summary()</span>
                        <a asp-page="/Details" asp-route-kind="lost" asp-route-id="@item.Id"
                           class="btn btn-sm btn-lostlink flex-shrink-0">View</a>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-lostlink text-white fw-bold">Latest found reports</div>
            <ul class="list-group list-group-flush">
                @foreach (var item in Model.LatestFound)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span>@item.Summary()</span>
                        <a asp-page="/Details" asp-route-kind="found" asp-route-id="@item.Id"
                           class="btn btn-sm btn-lostlink flex-shrink-0">View</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
